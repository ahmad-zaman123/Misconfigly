# Required
DATABASE_URL=postgresql://user:password@localhost:5432/misconfigly
JWT_SECRET=replace-with-a-long-random-string

# The frontend's address. The first one is also used for links in emails.
CORS_ALLOWED_ORIGINS=http://localhost:5190

# Optional: Continue with Google is hidden without it.
GOOGLE_CLIENT_ID=

# Optional: password reset is hidden without SMTP_USER and SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
